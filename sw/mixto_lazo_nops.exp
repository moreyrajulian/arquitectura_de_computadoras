# mixto_lazo_nops: estado final esperado, calculado a mano desde isa.md
regs:
  x1  = 0x00000114
  x2  = 0x00000010
  x5  = 0x0000000D
  x10 = 0x00000023
dmem:
  0x100 = 0x00000001
  0x104 = 0x00000004
  0x108 = 0x00000007
  0x10C = 0x0000000A
  0x110 = 0x0000000D
  0x200 = 0x00000023
halted = 1
pipeline_vacio = 1
avisos = ninguno
# Ejecutadas: 4 + 5 vueltas de 7 + 2 (nop del ultimo bne, no tomado)
#   + 3 + 5 vueltas de 9 + 2 + sw + halt = 93.
#   Los 2 nop de cada bne tomado los anula el flush y se cuentan como el costo
#   del salto (sin flush, en M7, se ejecutan y suman lo mismo).
ciclos = 113         # n = 93, + 4 de llenado, + 2 * 8 saltos tomados, sin stalls
