// Estado inicial de la memoria de datos para los programas indep_*.
//
// Formato de $readmemh: "@<indice>" es el indice de PALABRA en hex
// (direccion en bytes / 4) y el valor que sigue va en esa palabra. Las
// palabras que no aparecen valen 0: el testbench las pone en cero antes de
// leer este archivo. Ver sw/README.md.

@040 DEADBEEF   // 0x100: bytes EF BE AD DE (bit alto en 1 en los cuatro)
@041 7F018040   // 0x104: bytes 40 80 01 7F (bit alto en 0, 1, 0, 0)
@3FF CAFEBABE   // 0xFFC: ultima palabra
