# indep_store_load: estado final esperado, calculado a mano desde isa.md
# Parte de sw/estado_inicial/ (x1-x9 quedan como estaban).
regs:
  x1  = 0x00000007
  x2  = 0xFFFFFFFD
  x3  = 0x7FFFFFFF
  x4  = 0x80000000
  x5  = 0x00000021
  x6  = 0x00000100
  x7  = 0x00001000
  x8  = 0xDEADBEEF
  x9  = 0x12345678
  x11 = 0xDEADBEEF
  x12 = 0x00007800
  x13 = 0x0000FFFD
  x14 = 0x00000056
  x15 = 0xFFFFFFEF
  x16 = 0xEFAD0007
dmem:
  0x040 = 0xDEADBEEF
  0x044 = 0x00007800
  0x048 = 0xFFFD0000
  0x100 = 0xEFAD0007
  0x104 = 0x12345678
  0xFFC = 0xCAFEBABE
halted = 1
pipeline_vacio = 1
avisos = ninguno
ciclos = 17          # n = 13, + 4 de llenado, sin stalls
