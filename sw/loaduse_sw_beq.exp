# loaduse_sw_beq: estado final esperado, calculado a mano desde isa.md
regs:
  x1  = 0x00000033
  x2  = 0x00000033
  x4  = 0x00000020
  x5  = 0x00000033
  x6  = 0x00000033
  x7  = 0x00000033
  x8  = 0x00000020
  x9  = 0x00000099
  x10 = 0x00000064
  x11 = 0x00000064
  x12 = 0x00000058
dmem:
  0x000 = 0x00000033
  0x004 = 0x00000033
  0x008 = 0x00000064
  0x010 = 0x00000020
  0x020 = 0x00000033
halted = 1
pipeline_vacio = 1
avisos = ninguno
# Ejecutadas: las 11 primeras (hasta el beq) + lw, bne, addi x9, addi x10, sw,
#   lw, jalr y el halt de fin = 19
# Stalls: lw x5 -> sw, lw x8 -> sw, lw x6 -> beq, lw x7 -> bne, lw x11 -> jalr = 5
# Saltos tomados: beq y jalr = 2
ciclos = 32          # n = 19, + 4 de llenado, + 5 stalls, + 2 * 2 saltos tomados
