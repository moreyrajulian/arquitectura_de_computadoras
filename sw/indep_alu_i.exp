  x4  = 0x80000000
  x5  = 0x00000021
  x6  = 0x00000100
  x7  = 0x00001000
  x8  = 0xDEADBEEF
  x9  = 0x12345678
  x11 = 0xFFFFFFFF
  x12 = 0x000007FC
  x13 = 0x000000EF
  x14 = 0xDEADBE00
  x15 = 0xFFFFF807
  x16 = 0xEDCBA987
  x17 = 0x00000001
  x18 = 0x00000000
  x19 = 0x00000001
  x20 = 0x00000000
  x21 = 0x80000000
  x22 = 0x00000001
  x23 = 0xFFFFFFFF
  x24 = 0xFDEADBEE
  x25 = 0x0DEADBEE
