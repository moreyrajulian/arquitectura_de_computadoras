# salto_depende: estado final esperado, calculado a mano desde isa.md
regs:
  x1  = 0x00000005
  x2  = 0x00000006
  x3  = 0x00000006
  x4  = 0x00000005
  x5  = 0x00000050
  x6  = 0x00000040
  x8  = 0x00000008
  x9  = 0x00000009
  x10 = 0x00000010
dmem:
halted = 1
pipeline_vacio = 1
avisos = ninguno
# Ejecutadas: 0x00-0x10, 0x1C-0x2C, 0x38, 0x3C, 0x50 = 5 + 5 + 2 + 1 = 13
# Saltos tomados: beq 0x10, bne 0x2C, jalr 0x3C = 3
ciclos = 23          # n = 13, + 4 de llenado, + 2 * 3 saltos tomados
