# indep_stores: estado final esperado, calculado a mano desde isa.md
# Parte de sw/estado_inicial/ (x1-x9 quedan como estaban).
regs:
  x1  = 0x00000007
  x2  = 0xFFFFFFFD
  x3  = 0x7FFFFFFF
  x4  = 0x80000000
  x5  = 0x00000021
  x6  = 0x00000100
  x7  = 0x00001000
  x8  = 0xDEADBEEF
  x9  = 0x12345678
dmem:
  0x010 = 0xDEADBEEF
  0x020 = 0x0000BEEF
  0x024 = 0x56780000
  0x028 = 0x000078EF
  0x02C = 0x78EF0000
  0x100 = 0xDEADBEFD
  0x104 = 0x00078040
  0x108 = 0x00000007
  0x10C = 0x0000FFFD
  0xFF8 = 0x12345678
  0xFFC = 0xCAFEBABE
halted = 1
pipeline_vacio = 1
avisos = ninguno
ciclos = 17          # n = 13, + 4 de llenado
