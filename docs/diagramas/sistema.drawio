        <mxCell id="t_bus" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10.5;fontFamily=Helvetica;fontColor=#7B1FA2;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="clk_sys + rst → todos los bloques (incluidas las BRAM): un único dominio de reloj&lt;br&gt;El clock nunca se detiene ni se gatea: parar / avanzar el core se hace con enable" vertex="1">
          <mxGeometry height="38" width="1000" x="614" y="128" as="geometry" />
        </mxCell>
        <mxCell id="lg_ct" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" value="control (quién manda)" vertex="1">
