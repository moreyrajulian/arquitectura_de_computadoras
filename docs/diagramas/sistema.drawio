        </mxCell>
        <mxCell id="lg_dt" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" value="datos" vertex="1">
          <mxGeometry height="16" width="145" x="100" y="687" as="geometry" />
        </mxCell>
        <mxCell id="lg_bt" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" value="ida: dirección&lt;br&gt;vuelta: dato" vertex="1">
          <mxGeometry height="30" width="145" x="100" y="711" as="geometry" />
        </mxCell>
        <mxCell id="lg_kt" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" value="reloj / reset" vertex="1">
          <mxGeometry height="16" width="145" x="100" y="757" as="geometry" />
        </mxCell>
        <mxCell id="rules_c0" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=top;spacing=0;fontStyle=0;" value="&lt;b&gt;PC → Debug Unit&lt;/b&gt;&lt;br&gt;La PC nunca accede directo al core ni a las memorias: todo entra por la UART y lo interpreta la Debug Unit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Debug Unit → Core&lt;/b&gt;&lt;br&gt;Es el único maestro del core. RUN deja enable en 1 hasta el halt; STEP lo pone en 1 durante un solo ciclo; RESET&lt;br&gt;limpia pipeline y registros.&lt;br&gt;&lt;br&gt;&lt;b&gt;Core → Debug Unit&lt;/b&gt;&lt;br&gt;El core solo informa: levanta halt cuando la instrucción HALT llega a WB (pipeline vacío). La Debug Unit baja&lt;br&gt;enable y envía el dump.&lt;br&gt;" vertex="1">
          <mxGeometry height="175" width="770" x="48" y="948" as="geometry" />
        </mxCell>
        <mxCell id="rules_c1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=top;spacing=0;fontStyle=0;" value="&lt;b&gt;Memoria de programa&lt;/b&gt;&lt;br&gt;Solo la escribe la Debug Unit (puerto B), con el core detenido o en reset. El core solo la lee (puerto A).&lt;br&gt;Reprogramar no requiere resintetizar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Memoria de datos&lt;/b&gt;&lt;br&gt;Mientras ejecuta, su dueño es el core (puerto A). La Debug Unit solo la lee por el puerto B, con el core&lt;br&gt;detenido.&lt;br&gt;&lt;br&gt;&lt;b&gt;Clock Wizard&lt;/b&gt;&lt;br&gt;Genera el único reloj del sistema. Nadie lo detiene ni lo gatea (requisito de la consigna); el control de&lt;br&gt;ejecución es siempre por enable.&lt;br&gt;" vertex="1">
          <mxGeometry height="175" width="770" x="848" y="948" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
