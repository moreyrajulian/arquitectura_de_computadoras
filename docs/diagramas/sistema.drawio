        <mxCell id="t_clkin" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#7B1FA2;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" value="clk_in&lt;br&gt;(placa)" vertex="1">
