        <mxCell id="t29" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10.5;fontFamily=Helvetica;fontColor=#C62828;align=left;verticalAlign=middle;spacing=2;fontStyle=0;" value="LOAD con error&lt;br&gt;(CHK o timeout), o&lt;br&gt;RESET sin programa" vertex="1">
