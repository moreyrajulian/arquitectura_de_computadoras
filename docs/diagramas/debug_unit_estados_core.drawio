        </mxCell>
        <mxCell id="b30" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1.4;fontSize=10.5;fontFamily=Helvetica;fontColor=#616161;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" value="desde cualquier estado" vertex="1">
