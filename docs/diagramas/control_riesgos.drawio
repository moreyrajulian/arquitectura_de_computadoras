        <mxCell id="t111" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=10.5;fontFamily=Helvetica;fontColor=#AD1457;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="Unidad de detección de riesgos" vertex="1"><mxGeometry x="42" y="755" width="400" height="14" as="geometry" /></mxCell>
        <mxCell id="b112" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=1.6;fontSize=9;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Enables y flush&lt;/b&gt;&lt;br&gt;stall = load_use · ¬redirect&lt;br&gt;en_pc = en_if_id = enable · ¬stall&lt;br&gt;en_id_ex = en_ex_mem = en_mem_wb = enable&lt;br&gt;flush_if_id = redirect ∨ stop_fetch&lt;br&gt;flush_id_ex = redirect ∨ stall" vertex="1"><mxGeometry x="50" y="775" width="340" height="108" as="geometry" /></mxCell>
        <mxCell id="b113" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=1.6;fontSize=9;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Detector de carga-uso (load-use)&lt;/b&gt;&lt;br&gt;load_use = id_ex_mem_read · (id_ex_rd ≠ 0) · if_id_valid ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(id_ex_rd = if_id_rs1 ∨ id_ex_rd = if_id_rs2)&lt;br&gt;&lt;i&gt;compara los campos rs1/rs2 sin mirar el formato:&lt;br&gt;puede frenar de más, nunca de menos (decisión 011)&lt;/i&gt;" vertex="1"><mxGeometry x="440" y="775" width="350" height="108" as="geometry" /></mxCell>
