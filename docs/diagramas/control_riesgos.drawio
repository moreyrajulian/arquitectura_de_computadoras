        <mxCell id="t90" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#C62828;align=right;verticalAlign=middle;spacing=0;fontStyle=1;" value="redirect · redirect_pc  (salto tomado: flush de IF/ID e ID/EX)" vertex="1"><mxGeometry x="880" y="147" width="370" height="11" as="geometry" /></mxCell>
        <mxCell id="t91" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#C62828;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="redirect" vertex="1"><mxGeometry x="34" y="600" width="14" height="120" as="geometry" /></mxCell>
        <mxCell id="b92" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.2;fontSize=8.5;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#E65100;" value="&lt;b&gt;Camino crítico candidato&lt;/b&gt; (hipótesis, decisión 012):&lt;br&gt;load en WB → wb_data → fwd A/B → ALU → zero → taken → redirect → mux de PC → pc_reg (y redirect → flush). Se verifica con el reporte de timing en la integración." vertex="1"><mxGeometry x="1100" y="478" width="290" height="84" as="geometry" /></mxCell>
        <mxCell id="b93" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.6;fontSize=9;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Unidad de forwarding (EX)&lt;/b&gt;&lt;br&gt;fwd_a = &lt;b&gt;10&lt;/b&gt; si ex_mem_reg_write · ex_mem_rd ≠ 0 · ex_mem_rd = id_ex_rs1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= &lt;b&gt;01&lt;/b&gt; si no, si mem_wb_reg_write · mem_wb_rd ≠ 0 · mem_wb_rd = id_ex_rs1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= &lt;b&gt;00&lt;/b&gt; en otro caso&lt;br&gt;fwd_b: igual con id_ex_rs2 &amp;nbsp;·&amp;nbsp; &lt;i&gt;EX/MEM gana: es el valor más reciente&lt;/i&gt;" vertex="1"><mxGeometry x="950" y="585" width="430" height="105" as="geometry" /></mxCell>
        <mxCell id="e94" parent="1" style="html=1;rounded=0;edgeStyle=none;strokeColor=#1565C0;strokeWidth=1.8;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="650" as="sourcePoint" /><mxPoint x="950" y="650" as="targetPoint" /></mxGeometry></mxCell>
