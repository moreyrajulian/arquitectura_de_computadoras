        <mxCell id="t85" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" value="zero · alu_out" vertex="1"><mxGeometry x="1215" y="330" width="90" height="10" as="geometry" /></mxCell>
        <mxCell id="b86" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.6;fontSize=9;fontFamily=Helvetica;fontColor=#212121;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Resolución de saltos&lt;/b&gt;&lt;br&gt;taken = branch · (zero ⊕ funct3[0])&lt;br&gt;redirect = taken ∨ jal ∨ jalr&lt;br&gt;redirect_pc = PC + imm | rs1 + imm&lt;br&gt;&lt;b&gt;en EX, sin predicción&lt;/b&gt; (decisión 012)&lt;br&gt;&lt;i&gt;tomado: 2 ciclos · no tomado: 0&lt;/i&gt;" vertex="1"><mxGeometry x="1130" y="185" width="250" height="115" as="geometry" /></mxCell>
