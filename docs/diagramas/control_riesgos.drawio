        <mxCell id="e124" parent="1" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="775" as="sourcePoint" /><mxPoint x="815" y="700" as="targetPoint" /><Array as="points"><mxPoint x="375" y="732" /><mxPoint x="815" y="732" /></Array></mxGeometry></mxCell>
        <mxCell id="t125" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#C62828;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="en_id_ex · flush_id_ex" vertex="1"><mxGeometry x="490" y="735" width="170" height="11" as="geometry" /></mxCell>
        <mxCell id="e126" parent="1" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="926" as="sourcePoint" /><mxPoint x="110" y="883" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t127" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#C62828;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="stop_fetch (§3.4)" vertex="1"><mxGeometry x="116" y="905" width="110" height="11" as="geometry" /></mxCell>
        <mxCell id="e128" parent="1" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="926" as="sourcePoint" /><mxPoint x="250" y="883" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t129" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#C62828;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" value="enable (Debug Unit)" vertex="1"><mxGeometry x="256" y="905" width="130" height="11" as="geometry" /></mxCell>
        <mxCell id="t130" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=8.5;fontFamily=Helvetica;fontColor=#616161;align=left;verticalAlign=middle;spacing=0;fontStyle=2;" value="EX/MEM y MEM/WB: en = enable, sin flush. Prioridad en cada registro: rst &amp;gt; en &amp;gt; flush (§2):&lt;br&gt;con en = 0 el registro retiene aunque flush valga 1." vertex="1"><mxGeometry x="1220" y="860" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="b131" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;&lt;font style=&#x27;font-size:13px&#x27;&gt;Recursos compartidos: riesgos estructurales&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&#x27;border-collapse:collapse;font-size:9.5px;width:1140px&#x27; cellpadding=&#x27;3&#x27;&gt;&lt;tr style=&#x27;border-bottom:1px solid #9E9E9E&#x27;&gt;&lt;th align=&#x27;left&#x27;&gt;Recurso compartido&lt;/th&gt;&lt;th align=&#x27;left&#x27;&gt;Lo usan&lt;/th&gt;&lt;th align=&#x27;left&#x27;&gt;¿Riesgo estructural?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Memoria (instrucciones y datos)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IF y MEM, mismo ciclo&lt;/td&gt;&lt;td&gt;&lt;b&gt;No&lt;/b&gt; — memorias separadas (Harvard): IF usa la de programa y MEM la de datos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Banco de registros&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ID lee 2, WB escribe 1, mismo ciclo&lt;/td&gt;&lt;td&gt;&lt;b&gt;Sí → resuelto&lt;/b&gt; — 2 puertos de lectura + 1 de escritura; si es el mismo registro, bypass interno (007)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Puerto de escritura del banco&lt;/b&gt;&lt;/td&gt;&lt;td&gt;WB&lt;/td&gt;&lt;td&gt;&lt;b&gt;No&lt;/b&gt; — todas las instrucciones escriben en WB: a lo sumo una escritura por ciclo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ALU&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EX&lt;/td&gt;&lt;td&gt;&lt;b&gt;No&lt;/b&gt; — PC + 4 y PC + imm tienen sumadores propios; la ALU no se comparte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Etapas multiciclo&lt;/b&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;&lt;b&gt;No hay&lt;/b&gt; — sin M ni FP: cada etapa tarda 1 ciclo y queda libre al siguiente&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Puerto B de las BRAM, 3.er puerto del banco&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Debug Unit&lt;/td&gt;&lt;td&gt;&lt;b&gt;No&lt;/b&gt; — puertos propios; la DU escribe la memoria de programa con el core en reset y lee con enable = 0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Conclusión:&lt;/b&gt; ningún recurso compartido obliga a frenar el pipeline. El único conflicto real (ID y WB sobre el banco de registros) se resuelve dentro del banco, sin stall. Los únicos stalls y flush son por riesgos de datos (load-use) y de control (salto tomado)." vertex="1"><mxGeometry x="20" y="950" width="1170" height="250" as="geometry" /></mxCell>
        <mxCell id="b132" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;fontColor=#212121;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;&lt;font style=&#x27;font-size:13px&#x27;&gt;Referencias&lt;/font&gt;&lt;/b&gt;" vertex="1"><mxGeometry x="1210" y="950" width="670" height="250" as="geometry" /></mxCell>
        <mxCell id="e133" parent="1" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C62828;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1225" y="982" as="sourcePoint" /><mxPoint x="1275" y="982" as="targetPoint" /></mxGeometry></mxCell>
